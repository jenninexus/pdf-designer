# Personal workspace (contains private machine paths) — the .example version is tracked instead
pdf-designer.code-workspace

# Local project config (machine absolute paths). Tracked seed:
#   .config/mcp-pdf-designer.example.json → copy to mcp-pdf-designer.json
.config/mcp-pdf-designer.json

# Per-machine private session log (names private storage paths + related repos) — local only
dev-log-sego.yaml
dev-log-*.yaml

# Personal/private data — anything real (not *.example.*) that could name you, an employer,
# or contain unverified/sensitive claims stays local only. Applies at the repo root AND inside
# any examples/profiles/<your-id>/ folder you create from the default-resume template.
#
# storage/ holds EVERYTHING private: the claim vaults, the real applications, the exported
# PDFs, and (since 2026-07-20) storage/brand-design/ — the private brand palettes (mapped from
# www-theme-kit / syna-theme-kit profiles; never commit real vaults or personal contacts).
#
# ⚠ themes/ is deliberately NOT ignored. It is the PUBLIC engine's default theme + the palette
# RULE, which the code and docs depend on; a fresh clone must be able to render. Private brand
# palettes live in storage/brand-design/, which the previewer reads alongside themes/.
# Tracked brand TEMPLATE (no personal data): examples/brand-design/
private/
notes/
# Legacy private workspace (migration target: root users/vaults/profiles/… — see docs/WORKSPACE-LAYOUT.md)
storage/

# Root workspace nouns — track README + *.example.* only; real data stays local
users/*
!users/README.md
!users/*.example.json

vaults/*
!vaults/README.md
!vaults/*.example.json

profiles/*
!profiles/README.md
!profiles/*.example.json

resumes/*
!resumes/README.md

applications/*
!applications/README.md

collages/*
!collages/README.md

brands/*
!brands/README.md
!brands/*.example.json


# Private product/ops notes live in docs/ beside public docs (never clone these)
docs/MARKETING.md
docs/WORKSPACE.md
docs/HISTORY-SCRUB.md
docs/*.local.md

# Localized commands/docs — the TRACKED <name>.md is the generalized, shareable version;
# <name>.local.md is your copy with real company names, clients, and lessons in it.
*.local.md
**/*.local.md
resume-source.json
**/resume-source.json
collage-source.json
**/collage-source.json
job-listing-capture-*.md
**/job-listing-capture-*.md
!**/*.example.json
!**/*.example.md

# Personal slash commands — TRACK ONLY `*.example.md` on GitHub.
# Bare start/wrap/make-*/README are SEGO/dev-only (reflect, applicant specifics, session ritual).
.claude/commands/*
!.claude/commands/*.example.md
# Legacy explicit ignores (redundant once the glob above applies; kept for clarity)
.claude/commands/make-resume.md
.claude/commands/make-cover-letter.md
.claude/commands/make-work-examples.md
.claude/commands/make-collage.md
.claude/commands/start.md
.claude/commands/wrap.md
.claude/commands/pdf-wrap.md
.claude/commands/README.md

# Codex runtime adapters — generated one-way from local bare .claude commands (SKILL.md format).
# They may contain the same private/dev specifics as their source, so they stay local and untracked.
# Public command seeds are only .claude/commands/*.example.md; never generate public mirrors here.
.codex/

# Generated output + personal images (collage sets, screenshots) — real image
# files stay local; a future tracked example image needs an explicit ! exception
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.gif
output/
_exports/
**/_exports/
_variants/
**/_variants/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.eggs/

# Node (if a future browser-extension/UI layer is added)
node_modules/
dist/
build/

# Wheel share tree (generated by scripts/sync-wheel-share.py — SSOT stays at repo root)
src/pdf_tool/share/themes/
src/pdf_tool/share/layouts/
src/pdf_tool/share/examples/

# Playwright MCP capture dumps (local agent debugging artifacts)
.playwright-mcp/

# Editor/OS cruft
.DS_Store
Thumbs.db
.vscode/*.log

# Personal VS Code MCP wiring (contains local machine paths). The tracked
# .vscode/mcp.json.example is the agnostic template; the repo needs no MCP to run.
.vscode/mcp.json

# Secrets — defensive only.
# This tool reads NO environment variables and makes NO network calls; there is nothing
# for a .env to hold, which is why no .env.example ships (it would document a fiction).
# These lines stay purely so a future contributor's stray .env can never be committed.
.env
.env.*
!.env.example
