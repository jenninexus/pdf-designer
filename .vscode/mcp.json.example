{
  "_meta": {
    "description": "OPTIONAL VS Code MCP helper for pdf-designer. Copy to .vscode/mcp.json and edit paths for your machine. This repo needs NO MCP server to run — the engine is pure Python + Playwright. This file only wires an optional local admin/helper server if you happen to run one; delete the `servers` block if you don't.",
    "project_ssot": ".config/mcp-pdf-designer.json"
  },
  "servers": {
    "//": "OPTIONAL. Remove this block if you have no local MCP server. Paths below are placeholders — edit for your machine or delete.",
    "example-local-helper": {
      "command": "node",
      "args": ["/absolute/path/to/your/mcp-server/index.js"],
      "cwd": "/absolute/path/to/your/mcp-server"
    }
  }
}
