{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Design Hub: start on folder open",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/ensure-design-hub.ps1", "-NoOpen"],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "Design Hub: open in browser",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/ensure-design-hub.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    }
  ]
}
