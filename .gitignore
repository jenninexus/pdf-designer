# Personal workspace (contains private machine paths) — the .example version is tracked instead
pdf-designer.code-workspace

# Personal/private data — anything real (not *.example.*) that could name you, an employer,
# or contain unverified/sensitive claims stays local only. Applies at the repo root AND inside
# any examples/profiles/<your-id>/ folder you create from the default-resume template.
#
# storage/ holds EVERYTHING private: the claim vaults, the real applications, the exported
# PDFs, and (since 2026-07-14) storage/brands/ — the private brand palettes (mapped from
# www-theme-kit / syna-theme-kit profiles; never commit real vaults or personal contacts).
#
# ⚠ themes/ is deliberately NOT ignored. It is the PUBLIC engine's default theme + the palette
# RULE, which the code and docs depend on; a fresh clone must be able to render. Private brand
# palettes live in storage/brands/, which the previewer reads alongside themes/.
# Tracked brand TEMPLATE (no personal data): examples/brands/
private/
notes/
storage/

# Localized commands/docs — the TRACKED <name>.md is the generalized, shareable version;
# <name>.local.md is your copy with real company names, clients, and lessons in it.
*.local.md
**/*.local.md
resume-source.json
**/resume-source.json
collage-source.json
**/collage-source.json
job-listing-capture-*.md
**/job-listing-capture-*.md
!**/*.example.json
!**/*.example.md

# Generated output + personal images (collage sets, screenshots) — real image
# files stay local; a future tracked example image needs an explicit ! exception
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.gif
output/
_exports/
**/_exports/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.eggs/

# Node (if a future browser-extension/UI layer is added)
node_modules/
dist/
build/

# Editor/OS cruft
.DS_Store
Thumbs.db
.vscode/*.log

# Secrets — defensive only.
# This tool reads NO environment variables and makes NO network calls; there is nothing
# for a .env to hold, which is why no .env.example ships (it would document a fiction).
# These lines stay purely so a future contributor's stray .env can never be committed.
.env
.env.*
!.env.example

