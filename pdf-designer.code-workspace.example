{
  "folders": [
    {
      "name": "pdf-designer",
      "path": "."
    }
  ],
  "settings": {
    "git.enabled": true,
    "files.exclude": {
      "**/node_modules/**": true,
      "**/__pycache__/**": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/storage/**": true,
      "**/_exports/**": true
    },
    "python.analysis.typeCheckingMode": "basic",
    "task.allowAutomaticTasks": "on",
    "task.autoDetect": "on",
    "window.title": "PDF Designer - ${activeEditorShort}"
  },
  "extensions": {
    "recommendations": ["ms-python.python"]
  }
}
