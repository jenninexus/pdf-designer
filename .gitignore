# Personal workspace (contains private machine paths) — the .example version is tracked instead
pdf-designer.code-workspace

# Local project config (machine absolute paths). Tracked seed:
#   .config/mcp-pdf-designer.example.json → copy to mcp-pdf-designer.json
.config/mcp-pdf-designer.json

# Per-machine private session logs/channels — DEPRECATED (do not recreate at repo root).
# Frozen copy: Plans/_Complete/_archive/dev-log-sego.yaml
# Current work lives in the dated plan named by Plans/_Active/README.md + docs/ROADMAP.md.
dev-log.yaml
dev-log-sego.yaml
dev-log-*.yaml
dev-chat.md

# Personal/private data — anything real (not *.example.*) that could name you, an employer,
# or contain unverified/sensitive claims stays local only. Applies at the repo root AND inside
# any examples/profiles/<your-id>/ folder you create from the default-resume template.
#
# ONE checkout, two layers — you do not need a second app, and you do not need .env:
#   tracked  = engine + examples/ + README + *.example.json  (what a stranger clones)
#   ignored  = your users/ vaults/ profiles/ resumes/ _job-apps/ collages/ brands/
# Optional local pointers: .config/mcp-pdf-designer.json (copy the .example). The engine
# reads NO environment variables; a .env.local would be a fiction unless a new tool reads it.
#
# storage/ is retired (2026-08-17). Keep the ignore so a leftover tree cannot be committed.
storage/
#
# ⚠ themes/ is deliberately NOT ignored. It is the PUBLIC engine's default theme + the palette
# RULE. Private brand palettes live in brands/, which the previewer reads alongside themes/.
# Tracked brand TEMPLATE (no personal data): examples/brand-design/
private/
notes/
# Root workspace nouns — track README + *.example.* only; real data stays local
users/*
!users/README.md
!users/*.example.json
!users/examples.json

vaults/*
!vaults/README.md
!vaults/*.example.json
!vaults/examples.json

profiles/*
!profiles/README.md
!profiles/*.example.json
!profiles/examples.json

resumes/*
!resumes/README.md

_job-apps/*
!_job-apps/README.md
!_job-apps/_template/

# Brief 2026-08 name — runtime alias only; listings live in _job-apps/
applications/

collages/*
!collages/README.md

brands/*
!brands/README.md
!brands/*.example.json


# Private product/ops notes live in docs/ beside public docs (never clone these)
docs/MARKETING.md
docs/WORKSPACE.md
docs/HISTORY-SCRUB.md
# AGENTS.md is the tracked, vendor-neutral contributor SSOT.
# Lessons travel with the clone (README + lesson-*.md). Other .memory/ notes stay local.
.memory/*
!.memory/README.md
!.memory/lesson-*.md
# MEMORY.md is a tracked pointer to README.md (the /start convention looks for it).
!.memory/MEMORY.md
Plans/*
!Plans/README.md
!Plans/_Active/
Plans/_Active/*
!Plans/_Active/README.md
# Any dated public checklist (YYYY-MM-DD-slug.md) is tracked; *.local.md stays private.
!Plans/_Active/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.md
Plans/_Active/*.local.md
!Plans/_Complete/
Plans/_Complete/*
!Plans/_Complete/2026-09-26-roadmap-completed-archive.md
!Plans/_Complete/2026-09-26-private-preview-routing-and-product-carryover.md
!Plans/_Complete/2026-09-27-shade-resource-audit.md
!Plans/_Complete/2026-09-27-pdf-work.md
!Plans/_Complete/2026-09-29-pdf-work.md
docs/*.local.md
docs/private/
docs/**/*.private.md

# Localized commands/docs — the TRACKED <name>.md is the generalized, shareable version;
# <name>.local.md is your copy with real company names, clients, and lessons in it.
*.local.md
**/*.local.md
resume-source.json
**/resume-source.json
collage-source.json
**/collage-source.json
job-listing-capture-*.md
**/job-listing-capture-*.md
!**/*.example.json
!**/*.example.md

# Personal slash commands — TRACK ONLY `*.example.md` on GitHub.
# Bare start/wrap/make-*/README are SEGO/dev-only (reflect, applicant specifics, session ritual).
.claude/commands/*
!.claude/commands/*.example.md
# Legacy explicit ignores (redundant once the glob above applies; kept for clarity)
.claude/commands/make-resume.md
.claude/commands/make-cover-letter.md
.claude/commands/make-work-examples.md
.claude/commands/make-collage.md
.claude/commands/start.md
.claude/commands/wrap.md
.claude/commands/pdf-start.md
.claude/commands/pdf-wrap.md
.claude/commands/README.md

# Codex runtime adapters — generated one-way from local bare .claude commands (SKILL.md format).
# They may contain the same private/dev specifics as their source, so they stay local and untracked.
# Public command seeds are only .claude/commands/*.example.md; never generate public mirrors here.
.codex/
.agents/

# Generated output + personal images (collage sets, screenshots) — real image
# files stay local; a future tracked example image needs an explicit ! exception
*.pdf
!docs/pdf-designer-overview.pdf
*.png
!docs/images/**/*.png
# Real-applicant Hub captures belong beside their document family (or the _exports/ fallback), never public docs media.
docs/images/hub-resume-*.png
*.jpg
*.jpeg
*.webp
*.gif
# Explicit automation/test scratch only. User-facing exports live beside their document family
# (resumes/<user>/, collages/<project>/); _exports/ is the fallback.
output/*
!output/README.md
# Personal/private generated deliverables. Keep the root guide visible in public clones;
# ignore every payload and any accidental nested _exports directory.
**/_exports/
!/_exports/
/_exports/*
!/_exports/README.md
# CLI mishap: pdf_to_png treats a leftover flag as a positional out-dir
--output-dir/
_variants/
**/_variants/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.eggs/

# Node (if a future browser-extension/UI layer is added)
node_modules/
dist/
build/
desktop/runtime/
desktop/workspace-seed/
desktop/release/
desktop/.runtime-build/
desktop/azure-trusted-signing.json

# Wheel share tree (generated by scripts/sync-wheel-share.py — SSOT stays at repo root)
src/pdf_tool/share/themes/
src/pdf_tool/share/layouts/
src/pdf_tool/share/examples/

# Playwright MCP capture dumps (local agent debugging artifacts)
.playwright-mcp/

# pytest --basetemp (or TMPDIR pointed at the repo) drops pytest-of-<user>/ here
pytest-of-*/

# Editor/OS cruft
.DS_Store
Thumbs.db
.vscode/*.log

# Personal VS Code MCP wiring (contains local machine paths). The tracked
# .vscode/mcp.json.example is the agnostic template; the repo needs no MCP to run.
.vscode/mcp.json

# Secrets — defensive only.
# This tool reads NO environment variables and makes NO network calls; there is nothing
# for a .env / .env.local to hold, which is why no .env.example ships (it would document
# a fiction). Local machine paths go in .config/mcp-pdf-designer.json (gitignored above).
# These lines stay purely so a future contributor's stray .env can never be committed.
.env
.env.*
!.env.example
